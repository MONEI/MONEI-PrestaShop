# Test mode API key of the MONEI account the suite pays with. Required.
# Seeding stops on a live mode key: the suite takes real payments.
MONEI_TEST_API_KEY=

# Account id the API key belongs to. Required.
# Without it the module renders no payment option at all: MONEI answers
# "400 Either accountId or paymentId must be provided", the method list comes
# back empty, and the checkout says "no payment method available" with nothing
# in the log to explain why.
MONEI_TEST_ACCOUNT_ID=

# URL the browser drives and pays on.
# Defaults to http://localhost:8000, which the Flashlight compose file publishes.
#
# ⚠️ Card specs need more than this. 3D Secure frames the issuer challenge over
# HTTPS and MONEI must be able to reach the store, so a localhost store can never
# complete one. Start the ngrok service in the Flashlight stack and put the
# tunnel URL here to run the card specs.
# MONEI_E2E_BASE_URL=https://your-tunnel.ngrok-free.dev

# Docker Compose container running PrestaShop.
# The compose file sets `name: tunnel1`, so this is the default.
# MONEI_E2E_PS_CONTAINER=tunnel1-prestashop-1

# Back office login. Flashlight defaults.
# MONEI_E2E_ADMIN_PATH=/admin-dev
# MONEI_E2E_ADMIN_USER=admin@prestashop.com
# MONEI_E2E_ADMIN_PASSWORD=prestashop
